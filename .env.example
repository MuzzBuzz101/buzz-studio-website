# Free AI for Studio Concierge (recommended).
# Get a key at https://console.groq.com — free tier, no OpenAI credits needed.
GROQ_API_KEY=
# Optional override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=

# Optional free fallback if Groq is unset or fails.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=

# Studio presence (Europe/Nicosia hours 10:00–20:00 when auto).
AVAILABILITY_MODE=auto
# STUDIO_AVAILABLE is also accepted (auto|online|away|true|false).
STUDIO_AVAILABLE=

# --- Admin desk (/admin) ---
# Login password for the owner-only admin UI. Use a long random value.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Secret used to sign the httpOnly session cookie (HMAC). Use a different long random value.
ADMIN_SECRET=replace-with-a-long-random-secret

# Optional on localhost (uploads go to public/uploads/admin + data/admin-store.json).
# Required on Vercel for durable media uploads + store persistence:
# Vercel Dashboard → Storage → Blob → create store → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
# private (default) | public — must match your Blob store access mode
BLOB_ACCESS=private

# Analytics (public POST /api/analytics) stores visitors / pageviews / video views
# in the same admin store (local JSON or Blob). Cookie: bs_vid (1 year).
# No extra env vars required.
